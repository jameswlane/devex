{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "out/**"]
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
		},
		"test": {
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": []
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"start": {
			"dependsOn": ["build"],
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		}
	}
}
