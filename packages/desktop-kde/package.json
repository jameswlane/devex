{
	"name": "@devex/desktop-kde",
	"private": true,
	"version": "1.8.2",
	"description": "KDE Plasma desktop environment configuration plugin for DevEx CLI",
	"main": "main.go",
	"scripts": {
		"build": "node ../../scripts/turbo/go-task.mjs go build -o devex-plugin-desktop-kde *.go",
		"dev": "node ../../scripts/turbo/go-task.mjs go build -race -o devex-plugin-desktop-kde *.go",
		"test": "node ../../scripts/turbo/go-task.mjs go test ./...",
		"lint": "node ../../scripts/turbo/go-task.mjs golangci-lint run --allow-parallel-runners",
		"download": "node ../../scripts/turbo/go-task.mjs go mod download",
		"mod": "node ../../scripts/turbo/go-task.mjs go mod tidy",
		"vulncheck": "node ../../scripts/turbo/go-task.mjs vulncheck"
	},
	"keywords": [
		"devex",
		"plugin",
		"kde",
		"plasma",
		"desktop",
		"linux",
		"qt"
	],
	"author": "DevEx Team",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/jameswlane/devex",
		"directory": "packages/desktop-kde"
	},
	"devex": {
		"plugin": {
			"type": "desktop-environment",
			"platforms": [
				"linux"
			],
			"desktop": "kde",
			"dependencies": [
				"kwriteconfig5",
				"kreadconfig5",
				"qdbus"
			],
			"priority": 10,
			"capabilities": {
				"themes": true,
				"wallpapers": true,
				"panels": true,
				"widgets": true,
				"settings": true,
				"backup": true
			}
		}
	}
}
