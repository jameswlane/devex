{
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env",
				".env.local",
				".env.production",
				".env.production.local"
			],
			"env": [
				"NODE_ENV",
				"CI",
				"VERCEL",
				"NEXT_PUBLIC_*",
				"!NEXT_PUBLIC_VERCEL_URL"
			],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"test": {
			"dependsOn": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env",
				".env.local",
				".env.test",
				".env.test.local"
			],
			"env": [
				"NODE_ENV",
				"CI",
				"VERCEL",
				"NEXT_PUBLIC_*",
				"!NEXT_PUBLIC_VERCEL_URL"
			],
			"outputs": []
		},
		"dev": {
			"inputs": [
				"$TURBO_DEFAULT$",
				".env",
				".env.local",
				".env.development",
				".env.development.local"
			],
			"env": [
				"NODE_ENV",
				"CI",
				"VERCEL",
				"NEXT_PUBLIC_*",
				"!NEXT_PUBLIC_VERCEL_URL"
			],
			"passThroughEnv": ["PORT", "HOSTNAME"]
		},
		"start": {
			"env": [
				"NODE_ENV",
				"CI",
				"VERCEL",
				"NEXT_PUBLIC_*",
				"!NEXT_PUBLIC_VERCEL_URL"
			],
			"passThroughEnv": ["PORT", "HOSTNAME"]
		}
	}
}
