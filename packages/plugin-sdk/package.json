{
	"name": "@devex/plugin-sdk",
	"version": "0.0.3",
	"description": "Shared SDK for DevEx plugins",
	"private": true,
	"scripts": {
		"build": "node ../../scripts/turbo/go-task.mjs go build ./...",
		"test": "node ../../scripts/turbo/go-task.mjs go run github.com/onsi/ginkgo/v2/ginkgo run -r .",
		"lint": "node ../../scripts/turbo/go-task.mjs golangci-lint run --allow-parallel-runners",
		"download": "node ../../scripts/turbo/go-task.mjs go mod download",
		"mod": "node ../../scripts/turbo/go-task.mjs go mod tidy",
		"vulncheck": "node ../../scripts/turbo/go-task.mjs vulncheck"
	},
	"keywords": [
		"devex",
		"plugin",
		"sdk",
		"go"
	]
}
