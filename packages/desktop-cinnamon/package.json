{
	"name": "@devex/desktop-cinnamon",
	"private": true,
	"version": "1.8.2",
	"description": "Cinnamon desktop environment configuration plugin for DevEx CLI",
	"main": "main.go",
	"scripts": {
		"build": "node ../../scripts/turbo/go-task.mjs go build -o devex-plugin-desktop-cinnamon .",
		"dev": "node ../../scripts/turbo/go-task.mjs go build -race -o devex-plugin-desktop-cinnamon .",
		"test": "node ../../scripts/turbo/go-task.mjs go test ./...",
		"lint": "node ../../scripts/turbo/go-task.mjs golangci-lint run --allow-parallel-runners",
		"download": "node ../../scripts/turbo/go-task.mjs go mod download",
		"mod": "node ../../scripts/turbo/go-task.mjs go mod tidy",
		"vulncheck": "node ../../scripts/turbo/go-task.mjs vulncheck"
	},
	"keywords": [
		"devex",
		"plugin",
		"cinnamon",
		"desktop",
		"linux",
		"mint"
	],
	"author": "DevEx Team",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/jameswlane/devex",
		"directory": "packages/desktop-cinnamon"
	},
	"devex": {
		"plugin": {
			"type": "desktop-environment",
			"platforms": [
				"linux"
			],
			"desktop": "cinnamon",
			"dependencies": [
				"gsettings",
				"dconf",
				"cinnamon-settings"
			],
			"priority": 10,
			"capabilities": {
				"themes": true,
				"wallpapers": true,
				"applets": true,
				"settings": true,
				"backup": true
			}
		}
	}
}
