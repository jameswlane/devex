{
	"name": "@devex/tool-stackdetector",
	"private": true,
	"version": "1.8.2",
	"description": "Development stack detection plugin for DevEx CLI",
	"main": "main.go",
	"scripts": {
		"build": "node ../../scripts/turbo/go-task.mjs go build -o devex-plugin-tool-stackdetector .",
		"dev": "node ../../scripts/turbo/go-task.mjs go build -race -o devex-plugin-tool-stackdetector .",
		"test": "node ../../scripts/turbo/go-task.mjs go test ./...",
		"lint": "node ../../scripts/turbo/go-task.mjs golangci-lint run --allow-parallel-runners",
		"download": "node ../../scripts/turbo/go-task.mjs go mod download",
		"mod": "node ../../scripts/turbo/go-task.mjs go mod tidy",
		"vulncheck": "node ../../scripts/turbo/go-task.mjs vulncheck"
	},
	"keywords": [
		"development",
		"stack",
		"detection"
	],
	"author": "DevEx Team",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/jameswlane/devex",
		"directory": "packages/tool-stackdetector"
	},
	"devex": {
		"plugin": {
			"type": "tool",
			"platforms": [
				"linux",
				"darwin",
				"windows"
			],
			"dependencies": [],
			"priority": 3,
			"supports": {
				"detect": true,
				"analyze": true,
				"report": true
			}
		}
	}
}
