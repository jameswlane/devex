{
	"name": "@devex/package-manager-appimage",
	"private": true,
	"version": "1.8.2",
	"description": "AppImage plugin for DevEx CLI",
	"main": "main.go",
	"scripts": {
		"build": "node ../../scripts/turbo/go-task.mjs go build -o devex-plugin-package-manager-appimage .",
		"dev": "node ../../scripts/turbo/go-task.mjs go build -race -o devex-plugin-package-manager-appimage .",
		"test": "node ../../scripts/turbo/go-task.mjs go test ./...",
		"lint": "node ../../scripts/turbo/go-task.mjs golangci-lint run --allow-parallel-runners",
		"download": "node ../../scripts/turbo/go-task.mjs go mod download",
		"mod": "node ../../scripts/turbo/go-task.mjs go mod tidy",
		"vulncheck": "node ../../scripts/turbo/go-task.mjs vulncheck"
	},
	"keywords": [
		"appimage",
		"linux"
	],
	"author": "DevEx Team",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/jameswlane/devex",
		"directory": "packages/package-manager-appimage"
	},
	"devex": {
		"plugin": {
			"type": "package-manager",
			"platforms": [
				"linux"
			],
			"dependencies": [
				"AppImage"
			],
			"priority": 10,
			"supports": {
				"install": true,
				"remove": true,
				"update": true,
				"search": true,
				"list": true
			}
		}
	}
}
