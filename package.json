{
	"name": "devex",
	"version": "0.0.0",
	"description": "Used for release automation",
	"scripts": {
		"biome:format": "biome format --write",
		"biome:lint": "biome lint --write",
		"biome:check": "biome check --write",
		"build": "node scripts/turbo/run.mjs build",
		"build:go": "node scripts/turbo/run.mjs run build --filter=@devex/cli --filter='./packages/*'",
		"generate": "node scripts/turbo/run.mjs run generate",
		"download": "node scripts/turbo/run.mjs download",
		"dev": "node scripts/turbo/run.mjs dev",
		"lint": "node scripts/turbo/run.mjs lint",
		"lint:go": "node scripts/turbo/run.mjs run lint --filter=@devex/cli --filter='./packages/*'",
		"test": "node scripts/turbo/run.mjs test",
		"test:go": "node scripts/turbo/run.mjs run test --filter=@devex/cli --filter='./packages/*'",
		"test:ginkgo": "node scripts/turbo/run.mjs run test --filter=@devex/cli --filter='./packages/*'",
		"cli:build": "node scripts/turbo/run.mjs run build --filter=@devex/cli",
		"cli:test": "node scripts/turbo/run.mjs run test --filter=@devex/cli",
		"cli:lint": "node scripts/turbo/run.mjs run lint --filter=@devex/cli",
		"auto": "auto",
		"auto:version": "auto version",
		"auto:changelog": "auto changelog",
		"auto:release": "auto shipit",
		"web:build": "node scripts/turbo/run.mjs build --filter=@devex/web",
		"web:dev": "node scripts/turbo/run.mjs dev --filter=@devex/web",
		"docs:build": "node scripts/turbo/run.mjs build --filter=@devex/docs",
		"docs:dev": "node scripts/turbo/run.mjs dev --filter=@devex/docs",
		"release:generate": "node scripts/release/generate-goreleaser.mjs",
		"release:check": "node scripts/release/generate-goreleaser.mjs --check",
		"release:plan": "node scripts/release/release-plan.mjs",
		"release:test": "node --test scripts/release/*.test.mjs",
		"ci:test": "node --test scripts/ci/*.test.mjs",
		"act:lint": "actionlint .github/workflows/*.yml",
		"act:validate": "action-validator .github/workflows/*.yml",
		"act:test": "act push -W .github/workflows/ci.yml -n",
		"act:test:release": "act workflow_dispatch -W .github/workflows/release-components.yml -n",
		"act:check": "npm run act:lint && npm run act:validate",
		"docker:build": "apps/cli/scripts/docker.sh build",
		"docker:run": "apps/cli/scripts/docker.sh run",
		"docker:shell": "apps/cli/scripts/docker.sh shell",
		"docker:logs": "apps/cli/scripts/docker.sh logs",
		"docker:setup": "apps/cli/scripts/docker.sh setup",
		"docker:clean": "apps/cli/scripts/docker.sh clean",
		"typecheck": "node scripts/turbo/run.mjs run typecheck",
		"turbo:test": "node --test scripts/turbo/*.test.mjs",
		"turbo:run": "node scripts/turbo/run.mjs",
		"vulncheck": "node scripts/turbo/run.mjs run vulncheck --filter=@devex/cli --filter=./packages/*"
	},
	"keywords": [],
	"author": "James W Lane",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.18.2",
	"devDependencies": {
		"@auto-it/conventional-commits": "^11.3.6",
		"@auto-it/core": "^11.3.6",
		"@biomejs/biome": "2.6.8",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/format": "^21.2.3",
		"@octokit/rest": "^22.0.1",
		"auto": "^11.3.6",
		"commitlint": "^21.2.4",
		"glob": "^14.0.6",
		"js-yaml": "^5.5.0",
		"turbo": "2.11.13"
	},
	"pnpm": {
		"overrides": {
			"@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
			"browserslist@>=4.0.0 <4.28.7": "^4.28.7",
			"compression@<1.8.2": "1.8.2",
			"diff@>=8.0.0 <8.0.3": "^8.0.3",
			"mdast-util-to-hast@>=13.0.0 <13.2.1": "^13.2.1",
			"picomatch@>=4.0.0 <4.0.4": "^4.0.4",
			"ws@>=8.0.0 <8.21.0": "^8.21.0",
			"zod@>=4.0.0 <4.6.6": "^4.6.6"
		}
	}
}
