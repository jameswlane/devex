#!/bin/bash
# DevEx installer: curl -fsSL https://get.devex.sh/install | bash
#
# Everything runs inside main(), called on the last line, so a truncated download
# never executes a partial script.

set -euo pipefail

REPO="jameswlane/devex"
INSTALL_DIR="$HOME/.local/bin"
CHECKSUM_FILE="devex_checksums.txt"
TEMP_DIR=""

usage() {
    cat <<'EOF'
Usage: install [OPTIONS]

Options:
  --version X          Install CLI version X (with or without a leading v)
  --no-setup           Install only; do not run setup or prompt
  --non-interactive    Run devex install --non-interactive after installation
  --config PATH        Pass --config PATH to the setup/install command
  --install-dir DIR    Install into DIR (default: ~/.local/bin)
  --shell SHELL        Configure PATH for bash, zsh or fish (default: $SHELL)
  --base-url URL       Release download base URL; requires --version
  --help               Show this help

Environment:
  DEVEX_VERSION            Version to install
  DEVEX_NO_SETUP=1         Install only
  DEVEX_NONINTERACTIVE=1   Run devex install --non-interactive
  DEVEX_SHELL              Shell to configure (overridden by --shell)
EOF
}

cleanup() {
    if [ -n "$TEMP_DIR" ] && [ -d "$TEMP_DIR" ]; then
        rm -rf "$TEMP_DIR"
    fi
}

fetch() {
    if [ $# -eq 2 ]; then
        curl -fsSL -o "$2" "$1"
    else
        curl -fsSL "$1"
    fi
}

sha256_check() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -c -
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 -c -
    else
        echo "Error: Neither sha256sum nor shasum found; cannot verify the download." >&2
        return 1
    fi
}

print_install_command() {
    local command="$1"
    shift
    printf '  %s' "$command"
    printf ' %s' "$@"
    printf '\n'
}

check_dependencies() {
    local os="$1"
    local dependency
    local missing=()

    for dependency in curl git unzip; do
        if ! command -v "$dependency" >/dev/null 2>&1; then
            missing+=("$dependency")
        fi
    done

    if [ "${#missing[@]}" -eq 0 ]; then
        return
    fi

    echo "Error: Missing required dependencies: ${missing[*]}" >&2
    echo "Install them with your system package manager, then try again:" >&2
    if [ "$os" = "darwin" ]; then
        print_install_command "brew install" "${missing[@]}" >&2
    elif command -v apt-get >/dev/null 2>&1; then
        print_install_command "sudo apt-get install" "${missing[@]}" >&2
    elif command -v dnf >/dev/null 2>&1; then
        print_install_command "sudo dnf install" "${missing[@]}" >&2
    elif command -v yum >/dev/null 2>&1; then
        print_install_command "sudo yum install" "${missing[@]}" >&2
    elif command -v pacman >/dev/null 2>&1; then
        print_install_command "sudo pacman -S" "${missing[@]}" >&2
    elif command -v zypper >/dev/null 2>&1; then
        print_install_command "sudo zypper install" "${missing[@]}" >&2
    elif command -v apk >/dev/null 2>&1; then
        print_install_command "sudo apk add" "${missing[@]}" >&2
    else
        printf '  Required packages:' >&2
        printf ' %s' "${missing[@]}" >&2
        printf '\n' >&2
    fi
    return 1
}

# Tag behind github.com's /releases/latest redirect. Only CLI releases are marked
# latest (plugin goreleaser configs set make_latest: false), and the redirect is
# not subject to the unauthenticated API rate limit.
latest_release_redirect_tag() {
    local url
    url=$(curl -fsSIL -o /dev/null -w '%{url_effective}' "https://github.com/${REPO}/releases/latest") || return 1
    case "$url" in
        */releases/tag/*) printf '%s\n' "${url#*/releases/tag/}" ;;
        *) return 1 ;;
    esac
}

# GitHub API request, authenticated when a token is available (60 vs 5000 requests/hour).
fetch_github_api() {
    local token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
    if [ -n "$token" ]; then
        curl -fsSL -H "Authorization: Bearer $token" "$1"
    else
        curl -fsSL "$1"
    fi
}

# Newest vX.Y.Z tag. Plugin and SDK releases use packages/<name>/vX.Y.Z tags and
# are skipped. One page of 100 keeps this working even after a burst of plugin releases.
latest_cli_version() {
    local tag
    tag=$(latest_release_redirect_tag 2>/dev/null || true)
    if [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        printf '%s\n' "$tag"
        return
    fi
    fetch_github_api "https://api.github.com/repos/${REPO}/releases?per_page=100" |
        sed -n 's/.*"tag_name": *"\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p' |
        head -n 1
}

add_to_path() {
    local shell_config="$1"
    local path_line
    # shellcheck disable=SC2016 # Expand PATH when the shell reads the rc file.
    printf -v path_line 'export PATH="$PATH":%q' "$INSTALL_DIR"

    if [ -f "$shell_config" ] && grep -qxF "$path_line" "$shell_config"; then
        echo "  ✓ Already configured: $shell_config"
        return
    fi

    mkdir -p "$(dirname "$shell_config")"
    echo "  ✓ Adding to $shell_config"
    {
        echo ""
        echo "# DevEx CLI"
        echo "$path_line"
    } >> "$shell_config"
}

add_to_fish_path() {
    local shell_config="$1"

    if [ -f "$shell_config" ] && grep -qF "$INSTALL_DIR" "$shell_config"; then
        echo "  ✓ Already configured: $shell_config"
        return
    fi

    mkdir -p "$(dirname "$shell_config")"
    echo "  ✓ Adding to $shell_config"
    {
        echo ""
        echo "# DevEx CLI"
        printf "set -gx PATH \$PATH \"%s\"\n" "$INSTALL_DIR"
    } >> "$shell_config"
}

# Remove only installer-generated legacy entries, and only from the selected
# shell's rc files when switching to the default XDG binary location.
remove_legacy_path() {
    local shell_config="$1" line temporary removed=no
    [ -f "$shell_config" ] || return 0
    temporary=$(mktemp "${shell_config}.devex.XXXXXX")
    while IFS= read -r line || [ -n "$line" ]; do
        # shellcheck disable=SC2016 # Match the literal variables in old rc entries.
        case "$line" in
            "export PATH=\"\$PATH:$HOME/.local/share/devex/bin\""|\
            "export PATH=\"\$PATH\":$HOME/.local/share/devex/bin"|\
            'export PATH="$PATH:$HOME/.local/share/devex/bin"'|\
            "set -gx PATH \$PATH \"$HOME/.local/share/devex/bin\"") removed=yes ;;
            *) printf '%s\n' "$line" >> "$temporary" ;;
        esac
    done < "$shell_config"
    if [ "$removed" = yes ]; then
        cat "$temporary" > "$shell_config"
    fi
    rm -f "$temporary"
}

configure_path() {
    local os="$1"
    local target_shell="$2"

    if [ "$INSTALL_DIR" = "$HOME/.local/bin" ]; then
        case "$target_shell" in
            zsh) remove_legacy_path "$HOME/.zshrc" ;;
            fish) remove_legacy_path "$HOME/.config/fish/config.fish" ;;
            bash)
                remove_legacy_path "$HOME/.bashrc"
                if [ "$os" = darwin ]; then
                    if [ -f "$HOME/.bash_profile" ]; then
                        remove_legacy_path "$HOME/.bash_profile"
                    else
                        remove_legacy_path "$HOME/.profile"
                    fi
                fi
                ;;
        esac
    fi

    case ":${PATH:-}:" in
        *":$INSTALL_DIR:"*) echo "  ✓ Already on PATH: $INSTALL_DIR"; return ;;
    esac

    case "$target_shell" in
        zsh)
            add_to_path "$HOME/.zshrc"
            ;;
        fish)
            add_to_fish_path "$HOME/.config/fish/config.fish"
            ;;
        bash)
            add_to_path "$HOME/.bashrc"
            if [ "$os" = "darwin" ]; then
                if [ -f "$HOME/.bash_profile" ]; then
                    add_to_path "$HOME/.bash_profile"
                elif [ -f "$HOME/.profile" ]; then
                    add_to_path "$HOME/.profile"
                else
                    # Keep login shells connected to existing and future config.
                    # shellcheck disable=SC2016 # HOME expands when the login shell reads this file.
                    {
                        echo '[ -f "$HOME/.profile" ] && . "$HOME/.profile"'
                        echo '[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"'
                    } > "$HOME/.bash_profile"
                    add_to_path "$HOME/.bash_profile"
                fi
            fi
            ;;
        *)
            echo "  Shell '${target_shell:-unset}' is unsupported; no shell config was changed."
            echo "  To select a shell, rerun with --shell bash, --shell zsh or --shell fish."
            ;;
    esac

    echo "To add DevEx to another shell manually, add the matching line to its config:"
    echo "  bash: ~/.bashrc (also ~/.bash_profile or ~/.profile for macOS login shells); zsh: ~/.zshrc"
    printf "    export PATH=\"\$PATH\":%q\n" "$INSTALL_DIR"
    echo "  fish: ~/.config/fish/config.fish"
    printf "    set -gx PATH \$PATH \"%s\"\n" "$INSTALL_DIR"
    echo "Restart the configured shell to use DevEx."
}

print_setup_command() {
    local config="$1"
    printf '  devex setup'
    if [ -n "$config" ]; then
        printf ' --config %q' "$config"
    fi
    printf '\n'
}

main() {
    local requested_version="${DEVEX_VERSION:-}"
    local no_setup="${DEVEX_NO_SETUP:-0}"
    local non_interactive="${DEVEX_NONINTERACTIVE:-0}"
    local config=""
    local base_url=""
    local target_shell="${DEVEX_SHELL:-}"

    while [ $# -gt 0 ]; do
        case "$1" in
            --version)
                if [ $# -lt 2 ]; then
                    echo "Error: --version requires a value." >&2
                    usage >&2
                    exit 1
                fi
                requested_version="$2"
                shift 2
                ;;
            --no-setup)
                no_setup=1
                shift
                ;;
            --non-interactive)
                non_interactive=1
                shift
                ;;
            --config)
                if [ $# -lt 2 ]; then
                    echo "Error: --config requires a path." >&2
                    usage >&2
                    exit 1
                fi
                config="$2"
                shift 2
                ;;
            --install-dir)
                if [ $# -lt 2 ]; then
                    echo "Error: --install-dir requires a directory." >&2
                    usage >&2
                    exit 1
                fi
                INSTALL_DIR="$2"
                shift 2
                ;;
            --base-url)
                if [ $# -lt 2 ]; then
                    echo "Error: --base-url requires a URL." >&2
                    usage >&2
                    exit 1
                fi
                base_url="$2"
                shift 2
                ;;
            --shell)
                if [ $# -lt 2 ] || [ -z "$2" ]; then
                    echo "Error: --shell requires bash, zsh or fish." >&2
                    exit 1
                fi
                target_shell="$2"
                shift 2
                ;;
            --help)
                usage
                return
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                usage >&2
                exit 1
                ;;
        esac
    done

    if [ -n "$target_shell" ]; then
        case "$target_shell" in
            bash|zsh|fish) ;;
            *) echo "Error: Invalid shell '$target_shell'; use bash, zsh or fish (--shell or DEVEX_SHELL)." >&2; exit 1 ;;
        esac
    else
        target_shell="${SHELL:-}"
        target_shell="${target_shell##*/}"
    fi

    if [ -n "$base_url" ] && [ -z "$requested_version" ]; then
        echo "Error: --base-url requires an explicit --version." >&2
        exit 1
    fi

    echo "🚀 DevEx Installer"
    echo "=================="
    echo ""

    local os arch
    os=$(uname -s | tr '[:upper:]' '[:lower:]')
    arch=$(uname -m)

    case "$os" in
        linux|darwin) ;;
        *) echo "Unsupported operating system: $os" >&2; exit 1 ;;
    esac

    case "$arch" in
        x86_64|amd64) arch="amd64" ;;
        armv8*|aarch64|arm64) arch="arm64" ;;
        *) echo "Unsupported architecture: $arch" >&2; exit 1 ;;
    esac

    check_dependencies "$os"

    local tag
    if [ -n "$requested_version" ]; then
        tag="v${requested_version#v}"
        echo "✓ Requested version: $tag"
    else
        echo "Fetching latest version..."
        tag=$(latest_cli_version || true)
        if [ -z "$tag" ]; then
            echo "Error: Failed to fetch the latest release version." >&2
            echo "Please check your internet connection and try again." >&2
            exit 1
        fi
        echo "✓ Latest version: $tag"
    fi

    local version="${tag#v}"
    local filename="devex_${version}_${os}_${arch}.tar.gz"
    if [ -z "$base_url" ]; then
        base_url="https://github.com/${REPO}/releases/download"
    fi
    base_url="${base_url%/}/${tag}"

    TEMP_DIR=$(mktemp -d)
    trap cleanup EXIT

    echo "Downloading $filename..."
    fetch "$base_url/$filename" "$TEMP_DIR/$filename" || { echo "Error: Download failed" >&2; exit 1; }
    fetch "$base_url/$CHECKSUM_FILE" "$TEMP_DIR/$CHECKSUM_FILE" || { echo "Error: Checksum download failed" >&2; exit 1; }

    echo "Verifying checksum..."
    local expected
    expected=$(awk -v f="$filename" '$2 == f || $2 == "*"f { print; exit }' "$TEMP_DIR/$CHECKSUM_FILE")
    if [ -z "$expected" ]; then
        echo "Error: File '$filename' not found in checksum file." >&2
        echo "Available files in checksum:" >&2
        awk '{ print "  " $2 }' "$TEMP_DIR/$CHECKSUM_FILE" >&2
        exit 1
    fi

    local checksum_result
    if ! checksum_result=$(cd "$TEMP_DIR" && echo "$expected" | sha256_check 2>&1); then
        echo "Error: Checksum verification failed." >&2
        echo "Details: $checksum_result" >&2
        echo "This could indicate:" >&2
        echo "  - Corrupted download" >&2
        echo "  - Network tampering" >&2
        echo "  - Server-side issue" >&2
        echo "Please try downloading again or contact support." >&2
        exit 1
    fi
    echo "✓ Checksum verification successful"

    echo "Installing DevEx..."
    mkdir -p "$INSTALL_DIR"
    # Absolute, so the PATH line written to shell rc files works from any directory.
    INSTALL_DIR="$(cd "$INSTALL_DIR" && pwd)"
    mkdir -p "$TEMP_DIR/extracted"
    tar -xzf "$TEMP_DIR/$filename" -C "$TEMP_DIR/extracted"
    install -m 755 "$TEMP_DIR/extracted/bin/devex" "$INSTALL_DIR/devex"
    local data_dir="${XDG_DATA_HOME:-$HOME/.local/share}"
    case "$data_dir" in /*) ;; *) data_dir="$HOME/.local/share" ;; esac
    data_dir="$data_dir/devex"
    case "${DEVEX_DATA_DIR:-}" in /*) data_dir="$DEVEX_DATA_DIR" ;; esac
    mkdir -p "$data_dir"
    local directory
    for directory in config assets help migrations; do
        if [ -d "$TEMP_DIR/extracted/$directory" ]; then
            mkdir -p "$data_dir/$directory"
            cp -R "$TEMP_DIR/extracted/$directory/." "$data_dir/$directory/"
        fi
    done

    echo ""
    echo "Adding DevEx to PATH..."
    configure_path "$os" "$target_shell"

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "✅ DevEx installed successfully!"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    if [ "$no_setup" = "1" ]; then
        echo "To get started, run:"
        echo ""
        print_setup_command "$config"
        return
    fi

    local command_args=()
    if [ -n "$config" ]; then
        command_args+=(--config "$config")
    fi

    if [ "$non_interactive" = "1" ]; then
        "$INSTALL_DIR/devex" install --non-interactive ${command_args[@]+"${command_args[@]}"}
        return
    fi

    echo "To get started, run:"
    echo ""
    print_setup_command "$config"
    echo ""
    echo "This will guide you through setting up your"
    echo "development environment with your preferred tools."
    echo ""

    # stdin is this script when piped into bash, so prompt on the terminal instead
    if { : < /dev/tty; } 2>/dev/null; then
        printf "Press Enter to start the setup, or Ctrl+C to exit..." > /dev/tty
        read -r _ < /dev/tty
        "$INSTALL_DIR/devex" setup ${command_args[@]+"${command_args[@]}"} < /dev/tty
    else
        echo "After restarting your shell, run:"
        print_setup_command "$config"
    fi
}

main "$@"
