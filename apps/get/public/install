#!/bin/bash
# DevEx installer: wget -qO- https://devex.sh/install | bash
#
# Everything runs inside main(), called on the last line, so a truncated download
# never executes a partial script.

set -euo pipefail

REPO="jameswlane/devex"
INSTALL_DIR="$HOME/.local/share/devex"
CHECKSUM_FILE="devex_checksums.txt"
TEMP_DIR=""

cleanup() {
    if [ -n "$TEMP_DIR" ] && [ -d "$TEMP_DIR" ]; then
        rm -rf "$TEMP_DIR"
    fi
}

# fetch URL [OUTPUT_FILE]: prints to stdout, or saves to OUTPUT_FILE
fetch() {
    if command -v curl >/dev/null 2>&1; then
        if [ $# -eq 2 ]; then curl -fsSL -o "$2" "$1"; else curl -fsSL "$1"; fi
    else
        if [ $# -eq 2 ]; then wget -qO "$2" "$1"; else wget -qO- "$1"; fi
    fi
}

sha256_check() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -c -
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 -c -
    else
        echo "Error: Neither sha256sum nor shasum found; cannot verify the download." >&2
        return 1
    fi
}

# Newest vX.Y.Z tag. Plugin and SDK releases use packages/<name>/vX.Y.Z tags and
# are skipped. One page of 100 keeps this working even after a burst of plugin releases.
latest_cli_version() {
    fetch "https://api.github.com/repos/${REPO}/releases?per_page=100" |
        sed -n 's/.*"tag_name": *"\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p' |
        head -n 1
}

add_to_path() {
    local shell_config="$1"
    local path_line="export PATH=\"\$PATH:$INSTALL_DIR/bin\""

    if [ -f "$shell_config" ] && ! grep -q "$INSTALL_DIR/bin" "$shell_config"; then
        echo "  ✓ Adding to $shell_config"
        {
            echo ""
            echo "# DevEx CLI"
            echo "$path_line"
        } >> "$shell_config"
    fi
}

main() {
    echo "🚀 DevEx Installer"
    echo "=================="
    echo ""

    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        echo "Error: Neither curl nor wget found."
        echo "Please install curl or wget and try again:"
        echo ""
        echo "  Ubuntu/Debian: sudo apt-get install curl"
        echo "  Fedora/RHEL:   sudo dnf install curl"
        echo "  Arch:          sudo pacman -S curl"
        echo "  macOS:         brew install curl"
        echo ""
        exit 1
    fi

    # Determine OS and architecture
    local os arch
    os=$(uname -s | tr '[:upper:]' '[:lower:]')
    arch=$(uname -m)

    case "$os" in
        linux|darwin) ;;
        *) echo "Unsupported operating system: $os"; exit 1 ;;
    esac

    case "$arch" in
        x86_64|amd64) arch="amd64" ;;
        armv8*|aarch64|arm64) arch="arm64" ;;
        *) echo "Unsupported architecture: $arch"; exit 1 ;;
    esac

    echo "Fetching latest version..."
    local tag
    tag=$(latest_cli_version || true)
    if [ -z "$tag" ]; then
        echo "Error: Failed to fetch the latest release version."
        echo "Please check your internet connection and try again."
        exit 1
    fi
    echo "✓ Latest version: $tag"

    # Release assets are named without the leading "v": devex_1.2.3_linux_amd64.tar.gz
    local version="${tag#v}"
    local filename="devex_${version}_${os}_${arch}.tar.gz"
    local base_url="https://github.com/${REPO}/releases/download/${tag}"

    TEMP_DIR=$(mktemp -d)
    trap cleanup EXIT

    echo "Downloading $filename..."
    fetch "$base_url/$filename" "$TEMP_DIR/$filename" || { echo "Error: Download failed"; exit 1; }
    fetch "$base_url/$CHECKSUM_FILE" "$TEMP_DIR/$CHECKSUM_FILE" || { echo "Error: Checksum download failed"; exit 1; }

    echo "Verifying checksum..."
    local expected
    expected=$(awk -v f="$filename" '$2 == f || $2 == "*"f { print; exit }' "$TEMP_DIR/$CHECKSUM_FILE")
    if [ -z "$expected" ]; then
        echo "Error: File '$filename' not found in checksum file."
        echo "Available files in checksum:"
        awk '{ print "  " $2 }' "$TEMP_DIR/$CHECKSUM_FILE"
        exit 1
    fi

    local checksum_result
    if ! checksum_result=$(cd "$TEMP_DIR" && echo "$expected" | sha256_check 2>&1); then
        echo "Error: Checksum verification failed."
        echo "Details: $checksum_result"
        echo "This could indicate:"
        echo "  - Corrupted download"
        echo "  - Network tampering"
        echo "  - Server-side issue"
        echo "Please try downloading again or contact support."
        exit 1
    fi
    echo "✓ Checksum verification successful"

    echo "Installing DevEx..."
    mkdir -p "$INSTALL_DIR"
    tar -xzf "$TEMP_DIR/$filename" -C "$INSTALL_DIR"
    chmod +x "$INSTALL_DIR/bin/devex"

    echo ""
    echo "Adding DevEx to PATH..."
    add_to_path "$HOME/.bashrc"
    add_to_path "$HOME/.zshrc"

    if [ -f "$HOME/.config/fish/config.fish" ] && ! grep -q "$INSTALL_DIR/bin" "$HOME/.config/fish/config.fish"; then
        echo "  ✓ Adding to ~/.config/fish/config.fish"
        {
            echo ""
            echo "# DevEx CLI"
            echo "set -gx PATH \$PATH $INSTALL_DIR/bin"
        } >> "$HOME/.config/fish/config.fish"
    fi

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "✅ DevEx installed successfully!"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "To get started, run:"
    echo ""
    echo "  devex setup"
    echo ""
    echo "This will guide you through setting up your"
    echo "development environment with your preferred tools."
    echo ""

    # stdin is this script when piped into bash, so prompt on the terminal instead
    if { : < /dev/tty; } 2>/dev/null; then
        printf "Press Enter to start the setup, or Ctrl+C to exit..." > /dev/tty
        read -r _ < /dev/tty
        "$INSTALL_DIR/bin/devex" setup < /dev/tty
    else
        echo "Note: You may need to restart your shell or run:"
        echo "  source ~/.bashrc  (or ~/.zshrc for zsh)"
        echo ""
        echo "Then run: devex setup"
    fi
}

main "$@"
