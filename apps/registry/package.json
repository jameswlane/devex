		"@vercel/functions": "3.11.1",
		"bcrypt": "^6.0.0",
		"dotenv": "^18.0.10",
		"ioredis": "^6.0.0",
		"next": "16.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
