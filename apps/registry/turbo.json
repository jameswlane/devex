			"cache": false,
			"env": [
				"DATABASE_URL",
				"DATABASE_URL_POOLED",
				"DIRECT_DATABASE_URL",
				"PRISMA_DATABASE_URL",
				"POSTGRES_URL"
			],
			"persistent": true
		},
		"db:deploy": {
			"cache": false,
			"env": [
				"DATABASE_URL",
				"DATABASE_URL_POOLED",
				"DIRECT_DATABASE_URL",
				"PRISMA_DATABASE_URL",
				"POSTGRES_URL"
			]
		},
		"db:seed": {
			"dependsOn": ["db:generate"],
			"cache": false,
			"env": [
				"DATABASE_URL",
				"DATABASE_URL_POOLED",
				"DIRECT_DATABASE_URL",
				"PRISMA_DATABASE_URL",
				"POSTGRES_URL",
				"SEED_CONCURRENCY",
				"SEED_DB_BATCH_SIZE"
			]
		},
		"db:studio": {
			"cache": false,
			"env": [
				"DATABASE_URL",
				"DATABASE_URL_POOLED",
				"DIRECT_DATABASE_URL",
				"PRISMA_DATABASE_URL",
