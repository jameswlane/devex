		},
		"db:generate": {
			"cache": false,
			"inputs": ["prisma/**", "prisma.config.ts", ".env*"],
			"env": [
				"DATABASE_URL",
				"DATABASE_URL_POOLED",
				"DIRECT_DATABASE_URL",
				"PRISMA_DATABASE_URL",
				"!NEXT_PUBLIC_VERCEL_URL"
			],
			"passThroughEnv": ["POSTGRES_URL"],
			"outputs": ["generated/**"]
		},
