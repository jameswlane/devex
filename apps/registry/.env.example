# DevEx Registry environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.

DATABASE_URL="postgresql://localhost:5432/devex_registry_dev"

# Bearer token required for data writes:
#   POST /api/v1/applications, PUT/DELETE /api/v1/applications/:id
#   POST /api/v1/plugins,      PUT/DELETE /api/v1/plugins/:id
# If unset, these endpoints respond 503 (fail closed).
# Generate with: openssl rand -hex 32
REGISTRY_ADMIN_API_KEY=""

# Bearer token required for cache administration:
#   POST /api/v1/revalidate, POST/DELETE /api/v1/cache, POST /api/health
# If unset, these endpoints respond 503 (fail closed).
REVALIDATE_API_KEY=""

# HMAC-SHA256 secret for POST /api/v1/plugins/:id/releases.
# Set the same secret in the release workflow; this is separate from bearer keys.
# If unset, release webhooks respond 503 (fail closed).
# Generate with: openssl rand -hex 32
REGISTRY_RELEASE_WEBHOOK_SECRET=""
