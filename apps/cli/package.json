{
	"name": "@devex/cli",
	"version": "0.0.0",
	"private": true,
	"description": "DevEx CLI - Development Environment Setup Tool",
	"scripts": {
		"build": "node ../../scripts/turbo/go-task.mjs go build -o bin/devex ./cmd/main.go",
		"dev": "node ../../scripts/turbo/go-task.mjs go build -race -o bin/devex ./cmd/main.go",
		"docker:build": "scripts/docker.sh build",
		"docker:clean": "scripts/docker.sh clean",
		"docker:logs": "scripts/docker.sh logs",
		"docker:run": "scripts/docker.sh run",
		"docker:setup": "scripts/docker.sh setup",
		"docker:setup-auto": "scripts/docker.sh setup-auto",
		"docker:setup-verbose": "scripts/docker.sh setup-verbose",
		"docker:shell": "scripts/docker.sh shell",
		"download": "node ../../scripts/turbo/go-task.mjs go mod download",
		"lint": "node ../../scripts/turbo/go-task.mjs golangci-lint run --allow-parallel-runners",
		"mod": "node ../../scripts/turbo/go-task.mjs go mod tidy",
		"test": "node ../../scripts/turbo/go-task.mjs go test ./...",
		"vulncheck": "node ../../scripts/turbo/go-task.mjs vulncheck"
	}
}
