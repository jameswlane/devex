# Keep 5000 lines of history within the shell and save it to ~/.zsh_history:
HISTSIZE=5000
SAVEHIST=5000
HISTFILE=~/.zsh_history

# Resolve the DevEx data directory from this deployed file's location.
_devex_shell_dir=${${(%):-%x}:A:h}
export DEVEX_PATH="${_devex_shell_dir:h:h}"
unset _devex_shell_dir

# Keep the user's PATH and prepend DevEx directories only when missing.
case ":$PATH:" in
  *":$DEVEX_PATH/bin:"*) ;;
  *) export PATH="$DEVEX_PATH/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Enable mise if available.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
