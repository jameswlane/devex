# DevEx CLI end-to-end sandbox: Ubuntu 24.04.
#
# Built by scripts/e2e-docker.sh from a staged build context holding the
# `devex` and `e2e.test` binaries and the config fixtures in testdata/. The
# image is deliberately bare so the suite exercises first-run behaviour: the
# tester home is empty and no devex directories exist until the CLI creates
# them.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Mirror stalls are common on CI runners. APT's default 120 s timeout lets one
# stalled connection use up the apt plugin's whole 2-minute update budget, so
# fail a stalled connection after 20 s and retry it. The file stays in the
# image, so apt-get update during the tests retries too.
RUN printf '%s\n' 'Acquire::Retries "5";' 'Acquire::http::Timeout "20";' 'Acquire::https::Timeout "20";' \
        > /etc/apt/apt.conf.d/80-devex-e2e-retries

# Unpinned on purpose: the sandbox should track the distro's current packages.
# curl, git and unzip are the CLI's required startup dependencies.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gzip \
        procps \
        sudo \
        tar \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ubuntu:24.04 ships an `ubuntu` user at UID 1000; drop it so tester takes
# UID 1000, which matches most host users owning the /artifacts mount.
# The home is created by hand rather than with -m so /etc/skel is not copied.
RUN userdel --remove ubuntu \
    && useradd --no-create-home --home-dir /home/tester --shell /bin/bash --uid 1000 tester \
    && install -d -o tester -g tester -m 0755 /home/tester \
    && echo 'tester ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/tester \
    && chmod 0440 /etc/sudoers.d/tester \
    && install -d -o tester -g tester -m 0755 /artifacts

COPY devex /usr/local/bin/devex
COPY e2e.test /opt/devex-e2e/e2e.test
COPY testdata /opt/devex-e2e/testdata

ENV DEVEX_E2E_SANDBOX=1 \
    LANG=C.UTF-8

# hadolint ignore=DL3066
USER tester
WORKDIR /home/tester

# Extra arguments to `docker run` (for example --ginkgo.focus=...) are appended.
ENTRYPOINT ["/opt/devex-e2e/e2e.test", "--ginkgo.v", "--ginkgo.junit-report=/artifacts/junit.xml"]
