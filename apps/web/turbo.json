{
	"extends": ["//", "@devex/turbo-next"],
	"tasks": {
		"build": {
			"dependsOn": ["^build", "generate"]
		},
		"generate": {
			"dependsOn": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/apps/cli/config/applications/**/*.yaml"
			],
			"env": ["!NEXT_PUBLIC_VERCEL_URL"],
			"outputs": ["app/generated/**"]
		}
	}
}
